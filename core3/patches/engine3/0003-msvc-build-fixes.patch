diff --git a/MMOEngine/src/system/util/optional.hpp b/MMOEngine/src/system/util/optional.hpp
index 0130ef2..a0dd121 100644
--- a/MMOEngine/src/system/util/optional.hpp
+++ b/MMOEngine/src/system/util/optional.hpp
@@ -352,9 +352,22 @@ struct constexpr_optional_base
     ~constexpr_optional_base() = default;
 };
 
+#ifdef _MSC_VER
+// MSVC answers is_trivially_destructible for a class by instantiating its destructor, which needs
+// every member type complete. Core3's generated POD classes hold Optional<container of references>
+// to types they only forward-declare, so on MSVC class types skip the question and use the
+// non-trivial base; std::conditional keeps the trait from being evaluated for them at all.
+template <class T>
+using optional_trivial_destructor = typename std::conditional<
+    std::is_class<T>::value, std::false_type, is_trivially_destructible<T>>::type;
+#else
+template <class T>
+using optional_trivial_destructor = is_trivially_destructible<T>;
+#endif
+
 template <class T>
 using OptionalBase = typename std::conditional<
-    is_trivially_destructible<T>::value,                          // if possible
+    optional_trivial_destructor<T>::value,                        // if possible
     constexpr_optional_base<typename std::remove_const<T>::type>, // use base with trivial destructor
     optional_base<typename std::remove_const<T>::type>
 >::type;
