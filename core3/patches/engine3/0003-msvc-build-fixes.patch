MSVC build fixes in engine3:
- platform.h: PLATFORM_64 also for MSVC's _M_X64/_M_ARM64 (it only checked GCC's macros), and
  __PRETTY_FUNCTION__ as __FUNCSIG__.
- File.cpp: libgen.h is POSIX-only; small basename()/dirname() equivalents on Windows that accept
  both / and \.
- String.cpp: include <sstream> for std::ostringstream (MSVC does not pull it in indirectly).
- ProtectedHeap.cpp: go through intptr_t when casting a pointer to off_t (32-bit long on Windows).
- optional.hpp: on MSVC, class types skip is_trivially_destructible, which MSVC answers by
  instantiating the destructor and so needs types Core3's generated headers only forward-declare.

diff --git a/MMOEngine/src/system/io/File.cpp b/MMOEngine/src/system/io/File.cpp
index 7f2fc05..468e454 100755
--- a/MMOEngine/src/system/io/File.cpp
+++ b/MMOEngine/src/system/io/File.cpp
@@ -12,7 +12,65 @@
 
 #include <cerrno>
 
+#ifndef PLATFORM_WIN
 #include <libgen.h>
+#else
+#include <cstring>
+
+namespace {
+	// POSIX basename()/dirname() for Windows: '/' and '\\' both separate, modifies path like libgen
+	bool isSeparator(char c) {
+		return c == '/' || c == '\\';
+	}
+
+	char* basename(char* path) {
+		static char dot[] = ".";
+
+		if (path == nullptr || *path == '\0')
+			return dot;
+
+		char* end = path + strlen(path) - 1;
+
+		while (end > path && isSeparator(*end))
+			*end-- = '\0';
+
+		char* start = end;
+
+		while (start > path && !isSeparator(*(start - 1)))
+			start--;
+
+		return start;
+	}
+
+	char* dirname(char* path) {
+		static char dot[] = ".";
+
+		if (path == nullptr || *path == '\0')
+			return dot;
+
+		char* end = path + strlen(path) - 1;
+
+		while (end > path && isSeparator(*end))
+			end--;
+
+		while (end > path && !isSeparator(*end))
+			end--;
+
+		if (!isSeparator(*end))
+			return dot;
+
+		while (end > path && isSeparator(*(end - 1)))
+			end--;
+
+		if (end == path)
+			end++; // keep the root separator
+
+		*end = '\0';
+
+		return path;
+	}
+}
+#endif
 
 #include "File.h"
 
