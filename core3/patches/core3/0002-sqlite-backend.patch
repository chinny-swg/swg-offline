+struct sqlite3;
+
+namespace server {
+  namespace db {
+    namespace sqlite {
+
+	// Rows are copied out as text when the query runs, like mysql_store_result(), so callers
+	// see the same values the MySQL backend gives them: getString() is nullptr for NULL.
+	class SqliteResultSet : public engine::db::ResultSet {
+		std::vector<std::vector<std::string>> rows;
+		std::vector<std::vector<bool>> nulls;
+		int current;
+		sys::uint64 rowsAffected;
+		sys::uint64 lastInsertId;
+
+	public:
+		SqliteResultSet(std::vector<std::vector<std::string>>&& r, std::vector<std::vector<bool>>&& n,
+				sys::uint64 affected, sys::uint64 insertId)
+			: rows(std::move(r)), nulls(std::move(n)), current(-1), rowsAffected(affected), lastInsertId(insertId) {
+		}
+
+		bool next() {
+			return ++current < static_cast<int>(rows.size());
+		}
+
+		bool getBoolean(int index) {
+			return getInt(index) != 0;
+		}
+
+		int getInt(int index) {
+			const char* value = getString(index);
+			return value ? atoi(value) : 0;
+		}
+
+		sys::uint32 getUnsignedInt(int index) {
+			const char* value = getString(index);
+			return value ? (sys::uint32) strtoul(value, nullptr, 0) : 0;
+		}
+
+		sys::int64 getLong(int index) {
+			const char* value = getString(index);
+			return value ? strtoll(value, nullptr, 10) : 0;
+		}
+
+		sys::uint64 getUnsignedLong(int index) {
+			const char* value = getString(index);
+			return value ? strtoull(value, nullptr, 10) : 0;
+		}
+
+		float getFloat(int index) {
+			const char* value = getString(index);
+			return value ? (float) atof(value) : 0.f;
+		}
+
+		char* getString(int index) {
+			if (current < 0 || current >= static_cast<int>(rows.size()) || index < 0
+					|| index >= static_cast<int>(rows[current].size()) || nulls[current][index])
+				return nullptr;
+
+			return &rows[current][index][0];
+		}
+
+		sys::uint64 getRowsAffected() {
+			return rowsAffected;
+		}
+
+		sys::uint64 getLastAffectedRow() {
+			return lastInsertId;
+		}
+
+		sys::uint64 size() {
+			return rows.size();
+		}
+	};
+
+	// A single-file database for one-PC servers (Core3.DBType = "sqlite"). It accepts the
+	// MySQL-flavoured statements Core3 writes; see SqliteDialect.h.
+	class SqliteDatabase : public Database, public Mutex, public Logger {
+		sqlite3* db;
+		String path;
+
+		static const char* sqliteThreadName;
+		static int createDatabaseThread();
+
+		void createSchema();
+		[[noreturn]] void error(const char* query);
+
+	public:
+		SqliteDatabase(const String& name, const String& path);
+		~SqliteDatabase();
+
+		// dbname, user, password and port are ignored: the database is the file at `path`
+		void connect(const String& dbname, const String& user, const String& passw, int port);
+
+		void executeStatement(const char* statement);
+		void executeStatement(const String& statement);
+		void executeStatement(const StringBuffer& statement);
+
+		void doExecuteStatement(const String& statement);
+
+		engine::db::ResultSet* executeQuery(const char* statement);
+		engine::db::ResultSet* executeQuery(const String& statement);
+		engine::db::ResultSet* executeQuery(const StringBuffer& statement);
+
+		void commit();
+		void rollback();
+		void autocommit(bool doCommit);
+
+		void close();
+
+		int compareTo(const Database* database) const final {
+			if (this < database)
+				return 1;
+			else if (this > database)
+				return -1;
+			else
+				return 0;
+		}
+	};
+
+    } // namespace sqlite
+  } // namespace db
+} // namespace server
+
+#endif // WITH_SQLITE
+
+#endif /*SQLITEDATABASE_H_*/
diff --git a/MMOCoreORB/src/server/db/SqliteDialect.cpp b/MMOCoreORB/src/server/db/SqliteDialect.cpp
new file mode 100644
index 0000000000..378c42cda8
--- /dev/null
+++ b/MMOCoreORB/src/server/db/SqliteDialect.cpp
@@ -0,0 +1,293 @@
+/*
+				Copyright <SWGEmu>
+		See file COPYING for copying conditions.*/
+
+#ifdef WITH_SQLITE
+
+#include "SqliteDialect.h"
+
+#include <cctype>
+#include <cstdio>
+#include <ctime>
+
+#include <sqlite3.h>
+
+namespace server {
+  namespace db {
+    namespace sqlite {
+
+namespace {
+
+// Howard Hinnant's days_from_civil / civil_from_days: proleptic Gregorian, no timegm() needed
+int64_t daysFromCivil(int64_t y, unsigned m, unsigned d) {
+	y -= m <= 2;
+	const int64_t era = (y >= 0 ? y : y - 399) / 400;
+	const unsigned yoe = static_cast<unsigned>(y - era * 400);
+	const unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+	const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+	return era * 146097 + static_cast<int64_t>(doe) - 719468;
+}
+
+void civilFromDays(int64_t z, int64_t& y, unsigned& m, unsigned& d) {
+	z += 719468;
+	const int64_t era = (z >= 0 ? z : z - 146096) / 146097;
+	const unsigned doe = static_cast<unsigned>(z - era * 146097);
+	const unsigned yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+	const unsigned doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+	const unsigned mp = (5 * doy + 2) / 153;
+	d = doy - (153 * mp + 2) / 5 + 1;
+	m = mp + (mp < 10 ? 3 : -9);
+	y = static_cast<int64_t>(yoe) + era * 400 + (m <= 2);
+}
+
+bool startsWithWord(const std::string& s, size_t pos, const char* word) {
+	size_t i = 0;
+
+	for (; word[i] != '\0'; ++i) {
+		if (pos + i >= s.size() || std::toupper(static_cast<unsigned char>(s[pos + i])) != word[i])
+			return false;
+	}
+
+	return pos + i >= s.size() || !(std::isalnum(static_cast<unsigned char>(s[pos + i])) || s[pos + i] == '_');
+}
+
+size_t skipSpace(const std::string& s, size_t pos) {
+	while (pos < s.size() && std::isspace(static_cast<unsigned char>(s[pos])))
+		++pos;
+
+	return pos;
+}
+
+// Statement-level rewrites, applied where a statement starts
+size_t rewriteStatementStart(const std::string& in, size_t pos, std::string& out) {
+	size_t start = skipSpace(in, pos);
+
+	if (startsWithWord(in, start, "TRUNCATE")) {
+		size_t next = skipSpace(in, start + 8);
+
+		if (startsWithWord(in, next, "TABLE"))
+			next = skipSpace(in, next + 5);
+
+		out.append(in, pos, start - pos);
+		out += "DELETE FROM ";
+		return next;
+	}
+
+	return pos;
+}
+
+int64_t currentEpoch() {
+	return static_cast<int64_t>(std::time(nullptr));
+}
+
+void sqlNow(sqlite3_context* ctx, int, sqlite3_value**) {
+	std::string now = formatDateTime(currentEpoch());
+	sqlite3_result_text(ctx, now.c_str(), static_cast<int>(now.size()), SQLITE_TRANSIENT);
+}
+
+void sqlUnixTimestamp(sqlite3_context* ctx, int argc, sqlite3_value** argv) {
+	if (argc == 0) {
+		sqlite3_result_int64(ctx, currentEpoch());
+		return;
+	}
+
+	switch (sqlite3_value_type(argv[0])) {
+	case SQLITE_NULL:
+		sqlite3_result_null(ctx);
+		return;
+	case SQLITE_INTEGER:
+	case SQLITE_FLOAT:
+		sqlite3_result_value(ctx, argv[0]);
+		return;
+	default:
+		break;
+	}
+
+	int64_t epoch = 0;
+
+	// MySQL answers 0 for an invalid date rather than NULL
+	if (!parseDateTime(reinterpret_cast<const char*>(sqlite3_value_text(argv[0])), epoch))
+		epoch = 0;
+
+	sqlite3_result_int64(ctx, epoch);
+}
+
+void sqlAddTime(sqlite3_context* ctx, int, sqlite3_value** argv) {
+	if (sqlite3_value_type(argv[0]) == SQLITE_NULL || sqlite3_value_type(argv[1]) == SQLITE_NULL) {
+		sqlite3_result_null(ctx);
+		return;
+	}
+
+	int64_t epoch = 0, offset = 0;
+
+	if (!parseDateTime(reinterpret_cast<const char*>(sqlite3_value_text(argv[0])), epoch)
+			|| !parseTimeOffset(reinterpret_cast<const char*>(sqlite3_value_text(argv[1])), offset)) {
+		sqlite3_result_null(ctx);
+		return;
+	}
+
+	std::string sum = formatDateTime(epoch + offset);
+	sqlite3_result_text(ctx, sum.c_str(), static_cast<int>(sum.size()), SQLITE_TRANSIENT);
+}
+
+} // namespace
+
+std::string translateMySql(const std::string& sql) {
+	std::string out;
+	out.reserve(sql.size() + 16);
+
+	size_t i = rewriteStatementStart(sql, 0, out);
+
+	while (i < sql.size()) {
+		const char c = sql[i];
+
+		if (c == '\'' || c == '"') {
+			// MySQL string literal (double quotes are strings too without ANSI_QUOTES)
+			std::string value;
+			size_t j = i + 1;
+
+			for (; j < sql.size(); ++j) {
+				const char ch = sql[j];
+
+				if (ch == '\\' && j + 1 < sql.size()) {
+					const char esc = sql[++j];
+
+					switch (esc) {
+					case 'n': value += '\n'; break;
+					case 'r': value += '\r'; break;
+					case 't': value += '\t'; break;
+					case 'Z': value += '\x1a'; break;
+					case '0': break; // SQLite text cannot hold NUL
+					default: value += esc; break; // \\ \' \" and unknown escapes
+					}
+				} else if (ch == c) {
+					if (j + 1 < sql.size() && sql[j + 1] == c) {
+						value += c;
+						++j;
+					} else {
+						break;
+					}
+				} else {
+					value += ch;
+				}
+			}
+
+			out += '\'';
+
+			for (char ch : value) {
+				if (ch == '\'')
+					out += '\'';
+
+				out += ch;
+			}
+
+			out += '\'';
+			i = j + 1;
+		} else if (c == '`') {
+			size_t end = sql.find('`', i + 1);
+
+			if (end == std::string::npos)
+				end = sql.size() - 1;
+
+			out.append(sql, i, end - i + 1);
+			i = end + 1;
+		} else if (c == ';') {
+			out += c;
+			i = rewriteStatementStart(sql, i + 1, out);
+		} else {
+			out += c;
+			++i;
+		}
+	}
+
+	return out;
+}
+
+bool parseDateTime(const char* text, int64_t& epoch) {
+	if (text == nullptr)
+		return false;
+
+	int year = 0, month = 0, day = 0, hour = 0, minute = 0, second = 0;
+	int fields = std::sscanf(text, "%d-%d-%d%*[ T]%d:%d:%d", &year, &month, &day, &hour, &minute, &second);
+
+	if (fields != 3 && fields != 6)
+		return false;
+
+	if (month < 1 || month > 12 || day < 1 || day > 31 || hour < 0 || hour > 23
+			|| minute < 0 || minute > 59 || second < 0 || second > 60)
+		return false;
+
+	epoch = daysFromCivil(year, static_cast<unsigned>(month), static_cast<unsigned>(day)) * 86400
+		+ hour * 3600 + minute * 60 + second;
+
+	return true;
+}
+
+std::string formatDateTime(int64_t epoch) {
+	int64_t days = epoch / 86400;
+	int64_t secs = epoch % 86400;
+
+	if (secs < 0) {
+		secs += 86400;
+		--days;
+	}
+
+	int64_t year = 0;
+	unsigned month = 0, day = 0;
+	civilFromDays(days, year, month, day);
+
+	char buf[32];
+	std::snprintf(buf, sizeof(buf), "%04lld-%02u-%02u %02d:%02d:%02d", static_cast<long long>(year), month, day,
+			static_cast<int>(secs / 3600), static_cast<int>(secs % 3600 / 60), static_cast<int>(secs % 60));
+
+	return buf;
+}
+
+bool parseTimeOffset(const char* text, int64_t& seconds) {
+	if (text == nullptr)
+		return false;
+
+	bool negative = false;
+
+	while (std::isspace(static_cast<unsigned char>(*text)))
+		++text;
+
+	if (*text == '-') {
+		negative = true;
+		++text;
+	}
+
+	int hours = 0, minutes = 0, secs = 0;
+	int fields = std::sscanf(text, "%d:%d:%d", &hours, &minutes, &secs);
+
+	if (fields < 2 || hours < 0 || minutes < 0 || minutes > 59 || secs < 0 || secs > 59)
+		return false;
+
+	seconds = static_cast<int64_t>(hours) * 3600 + minutes * 60 + secs;
+
+	if (negative)
+		seconds = -seconds;
+
+	return true;
+}
+
+int registerMySqlFunctions(sqlite3* db) {
+	int rc = sqlite3_create_function(db, "NOW", 0, SQLITE_UTF8, nullptr, sqlNow, nullptr, nullptr);
+
+	if (rc == SQLITE_OK)
+		rc = sqlite3_create_function(db, "UNIX_TIMESTAMP", 0, SQLITE_UTF8, nullptr, sqlUnixTimestamp, nullptr, nullptr);
+
+	if (rc == SQLITE_OK)
+		rc = sqlite3_create_function(db, "UNIX_TIMESTAMP", 1, SQLITE_UTF8 | SQLITE_DETERMINISTIC, nullptr, sqlUnixTimestamp, nullptr, nullptr);
+
+	if (rc == SQLITE_OK)
+		rc = sqlite3_create_function(db, "ADDTIME", 2, SQLITE_UTF8 | SQLITE_DETERMINISTIC, nullptr, sqlAddTime, nullptr, nullptr);
+
+	return rc;
+}
+
+    } // namespace sqlite
+  } // namespace db
+} // namespace server
+
+#endif // WITH_SQLITE
