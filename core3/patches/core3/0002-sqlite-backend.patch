diff --git a/MMOCoreORB/src/server/db/SqliteDatabase.cpp b/MMOCoreORB/src/server/db/SqliteDatabase.cpp
new file mode 100644
index 0000000000..c551bbd9f6
--- /dev/null
+++ b/MMOCoreORB/src/server/db/SqliteDatabase.cpp
@@ -0,0 +1,240 @@
+/*
+				Copyright <SWGEmu>
+		See file COPYING for copying conditions.*/
+
+#ifdef WITH_SQLITE
+
+#include "engine/engine.h"
+
+#include "engine/core/Task.h"
+
+#include <sqlite3.h>
+
+#include "SqliteDatabase.h"
+#include "SqliteDialect.h"
+#include "SqliteSchema.h"
+
+using namespace server::db::sqlite;
+
+namespace {
+
+class SqliteTask final : public Task {
+	SqliteDatabase* database;
+	String query;
+
+public:
+	SqliteTask(SqliteDatabase* db, const String& q) : database(db), query(q) {
+	}
+
+	void run() final {
+		try {
+			database->doExecuteStatement(query);
+		} catch (const Exception& e) {
+			// already logged by SqliteDatabase::error()
+		}
+	}
+};
+
+} // namespace
+
+const char* SqliteDatabase::sqliteThreadName = "sqliteThread";
+
+int SqliteDatabase::createDatabaseThread() {
+	Core::getTaskManager()->initializeCustomQueue(sqliteThreadName, 1, false);
+
+	return 0;
+}
+
+SqliteDatabase::SqliteDatabase(const String& name, const String& path) : Mutex("SQLITE DB"), Logger(name), db(nullptr), path(path) {
+	setLockTracing(false);
+}
+
+SqliteDatabase::~SqliteDatabase() {
+	close();
+}
+
+void SqliteDatabase::connect(const String&, const String&, const String&, int) {
+	static int databaseThread = createDatabaseThread();
+
+	fatal(!databaseThread) << "could not create sqlite database thread";
+
+	{
+		Locker locker(this);
+
+		int slash = path.lastIndexOf('/');
+
+		if (slash > 0)
+			File::mkpath(path.subString(0, slash));
+
+		info(true) << "opening " << path;
+
+		if (sqlite3_open_v2(path.toCharArray(), &db, SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE | SQLITE_OPEN_FULLMUTEX, nullptr) != SQLITE_OK)
+			error("open");
+
+		sqlite3_busy_timeout(db, 5000);
+
+		if (registerMySqlFunctions(db) != SQLITE_OK)
+			error("register functions");
+	}
+
+	// executeQuery() takes the lock itself
+	UniqueReference<engine::db::ResultSet*> journal(executeQuery("PRAGMA journal_mode = WAL"));
+	UniqueReference<engine::db::ResultSet*> sync(executeQuery("PRAGMA synchronous = NORMAL"));
+	UniqueReference<engine::db::ResultSet*> tables(executeQuery("SELECT count(*) FROM sqlite_master WHERE type = 'table' AND name = 'accounts'"));
+
+	if (tables->next() && tables->getInt(0) == 0)
+		createSchema();
+}
+
+void SqliteDatabase::createSchema() {
+	info(true) << "creating schema version " << SCHEMA_VERSION << " in " << path;
+
+	UniqueReference<engine::db::ResultSet*> begin(executeQuery("BEGIN"));
+
+	try {
+		for (auto statement : SCHEMA_STATEMENTS) {
+			UniqueReference<engine::db::ResultSet*> result(executeQuery(statement));
+		}
+
+		UniqueReference<engine::db::ResultSet*> version(executeQuery("INSERT INTO db_metadata (schema_version) VALUES (" + String::valueOf(SCHEMA_VERSION) + ")"));
+		UniqueReference<engine::db::ResultSet*> commit(executeQuery("COMMIT"));
+	} catch (const Exception& e) {
+		sqlite3_exec(db, "ROLLBACK", nullptr, nullptr, nullptr);
+		throw;
+	}
+}
+
+void SqliteDatabase::doExecuteStatement(const String& statement) {
+	UniqueReference<engine::db::ResultSet*> result(executeQuery(statement));
+}
+
+void SqliteDatabase::executeStatement(const char* statement) {
+	Reference<Task*> task = new SqliteTask(this, statement);
+	task->setCustomTaskQueue(sqliteThreadName);
+	task->execute();
+}
+
+void SqliteDatabase::executeStatement(const String& statement) {
+	executeStatement(statement.toCharArray());
+}
+
+void SqliteDatabase::executeStatement(const StringBuffer& statement) {
+	executeStatement(statement.toString().toCharArray());
+}
+
+engine::db::ResultSet* SqliteDatabase::executeQuery(const char* statement) {
+	Locker locker(this);
+
+	if (db == nullptr)
+		throw DatabaseException("sqlite database " + path + " is not open");
+
+	const std::string sql = translateMySql(statement);
+
+	std::vector<std::vector<std::string>> rows;
+	std::vector<std::vector<bool>> nulls;
+	sys::uint64 affected = 0;
+
+	const char* tail = sql.c_str();
+
+	// Like mysql_store_result(): run everything, keep the rows of the statement that returned some
+	while (tail != nullptr && *tail != '\0') {
+		sqlite3_stmt* stmt = nullptr;
+
+		if (sqlite3_prepare_v2(db, tail, -1, &stmt, &tail) != SQLITE_OK)
+			error(statement);
+
+		if (stmt == nullptr) // whitespace or a trailing ';'
+			continue;
+
+		const int columns = sqlite3_column_count(stmt);
+		int rc;
+
+		if (columns > 0) {
+			rows.clear();
+			nulls.clear();
+		}
+
+		while ((rc = sqlite3_step(stmt)) == SQLITE_ROW) {
+			std::vector<std::string> row(columns);
+			std::vector<bool> rowNulls(columns);
+
+			for (int i = 0; i < columns; ++i) {
+				const unsigned char* text = sqlite3_column_text(stmt, i);
+
+				if (text == nullptr) {
+					rowNulls[i] = true;
+				} else {
+					row[i].assign(reinterpret_cast<const char*>(text), sqlite3_column_bytes(stmt, i));
+				}
+			}
+
+			rows.emplace_back(std::move(row));
+			nulls.emplace_back(std::move(rowNulls));
+		}
+
+		sqlite3_finalize(stmt);
+
+		if (rc != SQLITE_DONE)
+			error(statement);
+
+		affected = sqlite3_changes(db);
+	}
+
+	return new SqliteResultSet(std::move(rows), std::move(nulls), affected, sqlite3_last_insert_rowid(db));
+}
+
+engine::db::ResultSet* SqliteDatabase::executeQuery(const String& statement) {
+	return executeQuery(statement.toCharArray());
+}
+
+engine::db::ResultSet* SqliteDatabase::executeQuery(const StringBuffer& statement) {
+	return executeQuery(statement.toString().toCharArray());
+}
+
+void SqliteDatabase::commit() {
+	Locker locker(this);
+
+	if (db != nullptr && !sqlite3_get_autocommit(db))
+		sqlite3_exec(db, "COMMIT", nullptr, nullptr, nullptr);
+}
+
+void SqliteDatabase::rollback() {
+	Locker locker(this);
+
+	if (db != nullptr && !sqlite3_get_autocommit(db))
+		sqlite3_exec(db, "ROLLBACK", nullptr, nullptr, nullptr);
+}
+
+void SqliteDatabase::autocommit(bool doCommit) {
+	Locker locker(this);
+
+	if (db == nullptr)
+		return;
+
+	if (doCommit && !sqlite3_get_autocommit(db))
+		sqlite3_exec(db, "COMMIT", nullptr, nullptr, nullptr);
+	else if (!doCommit && sqlite3_get_autocommit(db))
+		sqlite3_exec(db, "BEGIN", nullptr, nullptr, nullptr);
+}
+
+void SqliteDatabase::close() {
+	Locker locker(this);
+
+	if (db == nullptr)
+		return;
+
+	sqlite3_close_v2(db);
+	db = nullptr;
+
+	info("closed");
+}
+
+void SqliteDatabase::error(const char* query) {
+	StringBuffer msg;
+	msg << "DatabaseException caused by query: " << query << "\n" << sqlite3_extended_errcode(db) << ": " << sqlite3_errmsg(db);
+	Logger::error(msg);
+
+	throw DatabaseException(msg.toString());
+}
+
+#endif // WITH_SQLITE
