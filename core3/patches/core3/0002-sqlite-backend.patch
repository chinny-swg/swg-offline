+/*
+				Copyright <SWGEmu>
+		See file COPYING for copying conditions.*/
+
+#ifndef SQLITEDIALECT_H_
+#define SQLITEDIALECT_H_
+
+#include <cstdint>
+#include <string>
+
+struct sqlite3;
+
+// Lets the MySQL-flavoured SQL Core3 writes run on SQLite. Kept free of engine3 types so it can
+// be tested on its own.
+namespace server {
+  namespace db {
+    namespace sqlite {
+
+	// Rewrites one or more MySQL statements for SQLite:
+	//  - 'it\'s' / "it's" string literals (backslash escapes, double quotes) -> 'it''s'
+	//  - TRUNCATE [TABLE] t -> DELETE FROM t
+	// `backtick` identifiers are left alone; SQLite accepts them.
+	std::string translateMySql(const std::string& sql);
+
+	// 'YYYY-MM-DD[ HH:MM:SS]' read as UTC -> seconds since the epoch. Returns false if unparsable.
+	bool parseDateTime(const char* text, int64_t& epoch);
+
+	// Seconds since the epoch -> 'YYYY-MM-DD HH:MM:SS' in UTC, the format of SQLite's CURRENT_TIMESTAMP.
+	std::string formatDateTime(int64_t epoch);
+
+	// '[-]HH:MM[:SS]' -> seconds. Returns false if unparsable.
+	bool parseTimeOffset(const char* text, int64_t& seconds);
+
+	// Adds the MySQL functions Core3 uses: NOW(), UNIX_TIMESTAMP([datetime]), ADDTIME(datetime, time).
+	// All times are UTC, consistent with DEFAULT CURRENT_TIMESTAMP columns.
+	int registerMySqlFunctions(sqlite3* db);
+
+    } // namespace sqlite
+  } // namespace db
+} // namespace server
+
+#endif /*SQLITEDIALECT_H_*/
