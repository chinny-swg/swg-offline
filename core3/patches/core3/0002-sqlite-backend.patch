+		"CREATE INDEX session_stats_ip ON session_stats (ip)",
+		"CREATE INDEX session_stats_galaxy_ip ON session_stats (galaxy_id, ip, account_id, character_oid)",
+
+		"CREATE TABLE db_metadata (schema_version INTEGER NOT NULL)",
+	};
+
+    } // namespace sqlite
